{
  "name": "kaeuzchenlager-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "backend/kaeuzchenlager/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/kaeuzchenlager",
        "command": "mvn quarkus:dev"
      }
    },
    "debug": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/kaeuzchenlager",
        "command": "mvn quarkus:dev -Ddebug=5005"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/kaeuzchenlager",
        "command": "mvn test"
      }
    },
    "cleanup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/kaeuzchenlager",
        "command": "mvn -Pformat-apply impsort:sort@impsort-sort formatter:format@format-apply"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/kaeuzchenlager",
        "envFile": ".secrets/secrets",
        "command": "mvn -DskipTests -DnvdApiDelay=8000 -DnvdApiKeyEnvironmentVariable=NVD_API_KEY clean package"
      },
      "outputs": ["{workspaceRoot}/backend/kaeuzchenlager/target"]
    }
  }
}
