{
  "name": "kaeuzchenlager-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "backend/kaeuzchenlager/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/kaeuzchenlager",
        "command": "mvn quarkus:dev"
      }
    },
    "debug": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/kaeuzchenlager",
        "command": "mvn quarkus:dev -Ddebug=5005"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/kaeuzchenlager",
        "command": "mvn test"
      }
    },
    "dev-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/kaeuzchenlager",
        "command": "mvn -DskipTests package"
      },
      "outputs": ["{workspaceRoot}/backend/kaeuzchenlager/target"]
    }
  }
}
