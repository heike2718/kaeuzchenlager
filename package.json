{
  "name": "kaeuzchenlager-monorepo",
  "private": true,
  "scripts": {
    "check-node": "node -e \"if(!process.version.startsWith('v22.')){console.error('\\n❌ Node 22 required. Current:',process.version,'\\n');process.exit(1)}\"",
    "preinstall": "npm run -s check-node",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:be\" \"npm run dev:fe\"",
    "dev:be": "nx run kaeuzchenlager-api:dev",
    "dev:debug": "nx run kaeuzchenlager-api:debug",
    "dev:fe": "nx run frontend:serve",
    "test": "npm run test:fe && npm run test:be",
    "test:fe": "nx run frontend:test",
    "test:fe:coverage": "nx run frontend:test-coverage",
    "test:be": "nx run kaeuzchenlager-api:test",
    "cleanup": "npm run cleanup:fe && npm run cleanup:be",
    "cleanup:fe": "nx run frontend:cleanup",
    "cleanup:be": "nx run kaeuzchenlager-api:cleanup",
    "check": "npm run check:fe && npm run check:be",
    "check:fe": "nx run frontend:format-check && nx run frontend:lint && nx run frontend:test",
    "check:be": "nx run kaeuzchenlager-api:test",
    "build": "nx run frontend:build",
    "build:qs": "nx run frontend:build --configuration=qs",
    "build:prod": "nx run frontend:build --configuration=prod",
    "package": "nx run orchestrator:package",
    "package:qs": "nx run orchestrator:package --configuration=qs",
    "package:prod": "nx run orchestrator:package --configuration=prod",
    "deploy:qs": "nx run orchestrator:deploy --configuration=qs",
    "deploy:prod": "nx run orchestrator:deploy --configuration=prod",
    "graph": "nx run frontend:graph"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nx": "22.5.2"
  },
  "engines": {
    "node": "22.x"
  },
  "nx": {}
}
