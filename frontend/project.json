{
  "name": "frontend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": "frontend",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx serve kaeuzchen-workspace"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "rm -rf dist/kaeuzchen-workspace && nx build kaeuzchen-workspace --configuration=development --base-href=/kaeuzchenlager/ --deploy-url=/kaeuzchenlager/"
      },
      "configurations": {
        "qs": {
          "command": "rm -rf dist/kaeuzchen-workspace && nx build kaeuzchen-workspace --configuration=qs --base-href=/kaeuzchenlager/ --deploy-url=/kaeuzchenlager/"
        },
        "prod": {
          "command": "rm -rf dist/kaeuzchen-workspace && nx build kaeuzchen-workspace --configuration=production --base-href=/kaeuzchenlager/ --deploy-url=/kaeuzchenlager/"
        }
      },
      "outputs": [
        "{workspaceRoot}/frontend/kaeuzchen-workspace/dist/kaeuzchen-workspace"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx test kaeuzchen-workspace"
      }
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx test kaeuzchen-workspace --coverage"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx lint kaeuzchen-workspace"
      }
    },
    "lint-fix": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx run kaeuzchen-workspace:lint-fix"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx run kaeuzchen-workspace:format"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx run kaeuzchen-workspace:format-check"
      }
    },
    "cleanup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx run kaeuzchen-workspace:cleanup"
      }
    }
  }
}
