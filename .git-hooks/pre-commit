#!/usr/bin/env bash
set -euo pipefail

STAGED="$(git diff --cached --name-only --diff-filter=ACM || true)"
[ -z "$STAGED" ] && exit 0

has_staged() {
  printf '%s\n' "$STAGED" | grep -E "$1" >/dev/null 2>&1
}

restage_matching_from_staged() {
  printf '%s\n' "$STAGED" | grep -E "$1" | while IFS= read -r f; do
    [ -f "$f" ] && git add "$f"
  done
}

if has_staged '^frontend/'; then
  echo "🔧 Frontend cleanup"
  npm run -s cleanup:fe
  restage_matching_from_staged '^frontend/'
fi

if has_staged '^backend/.*\.java$'; then
  echo "☕ Backend cleanup"
  npm run -s cleanup:be
  restage_matching_from_staged '^backend/.*\.java$'
fi

exit 0