{
    "name": "kaeuzchen-workspace",
    "$schema": "node_modules/nx/schemas/project-schema.json",
    "includedScripts": [],
    "projectType": "application",
    "prefix": "kl",
    "sourceRoot": "./src",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/kaeuzchen-workspace",
                "browser": "./src/main.ts",
                "polyfills": ["zone.js"],
                "tsConfig": "tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": ["./src/favicon.ico", "./src/assets"],
                "styles": [
                    "src/app/layout/theme.scss",
                    "src/styles.scss",
                    "node_modules/material-icons/iconfont/material-icons.css"
                ],
                "baseHref": "/kaeuzchenlager/",
                "outputHashing": "all"
            },
            "configurations": {
                "production": {
                    "fileReplacements": [
                        {
                            "replace": "src/app/config/configuration.ts",
                            "with": "src/app/config/configuration.prod.ts"
                        }
                    ],
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "1mb",
                            "maximumError": "1.1mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "300kb",
                            "maximumError": "350kb"
                        }
                    ]
                },
                "qs": {
                    "fileReplacements": [
                        {
                            "replace": "src/app/config/configuration.ts",
                            "with": "src/app/config/configuration.qs.ts"
                        }
                    ],
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "1mb",
                            "maximumError": "1.1mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "300kb",
                            "maximumError": "350kb"
                        }
                    ]
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            },
            "defaultConfiguration": "development"
        },
        "serve": {
            "executor": "@angular/build:dev-server",
            "configurations": {
                "development": {
                    "buildTarget": "kaeuzchen-workspace:build:development"
                }
            },
            "defaultConfiguration": "development",
            "continuous": true
        },
        "test": {
            "executor": "@nx/vite:test",
            "outputs": ["{options.reportsDirectory}"],
            "options": {
                "reportsDirectory": "coverage/kaeuzchen-workspace"
            }
        },
        "test-coverage": {
            "executor": "@nx/vite:test",
            "outputs": ["{options.reportsDirectory}"],
            "options": {
                "reportsDirectory": "coverage/kaeuzchen-workspace",
                "coverage": true
            }
        },
        "format": {
            "executor": "nx:run-commands",
            "options": {
                "command": "prettier --write \"src/**/*.{ts,html,scss}\" --ignore-path .prettierignore"
            }
        },
        "format-check": {
            "executor": "nx:run-commands",
            "options": {
                "command": "prettier --check \"**/*.{ts,html,scss}\" --ignore-path .prettierignore"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": ["./src"]
            }
        },
        "lint-fix": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": ["./src"],
                "fix": true
            }
        },
        "cleanup": {
            "executor": "nx:run-commands",
            "dependsOn": ["lint-fix", "format"],
            "options": {
                "command": "true"
            }
        },
        "graph": {
            "executor": "nx:run-commands",
            "options": {
                "command": "nx graph"
            }
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "kaeuzchen-workspace:build"
            }
        }
    }
}
