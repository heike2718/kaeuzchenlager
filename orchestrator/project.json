{
  "name": "orchestrator",
  "targets": {
    "stage-frontend": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build",
          "projects": ["frontend"],
          "params": "forward"
        }
      ],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf backend/kaeuzchenlager/src/main/resources/META-INF/resources/kaeuzchenlager",
          "mkdir -p backend/kaeuzchenlager/src/main/resources/META-INF/resources/kaeuzchenlager",
          "rsync -a --delete frontend/kaeuzchen-workspace/dist/kaeuzchen-workspace/browser/ backend/kaeuzchenlager/src/main/resources/META-INF/resources/kaeuzchenlager/"
        ]
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "stage-frontend",
          "projects": "self",
          "params": "forward"
        }
      ],
      "options": {
        "cwd": "backend/kaeuzchenlager",
        "envFile": ".secrets/secrets",
        "command": "mvn clean package -Dmaven.test.skip=true -DnvdApiDelay=8000 -DnvdApiKeyEnvironmentVariable=NVD_API_KEY"
      },
      "outputs": ["{workspaceRoot}/backend/kaeuzchenlager/target/quarkus-app"]
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "package",
          "projects": "self",
          "params": "forward"
        }
      ],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf /home/heike/deployments/x300-heikeqs/kaeuzchen/kaeuzchenlager/quarkus-app",
          "mv backend/kaeuzchenlager/target/quarkus-app /home/heike/deployments/x300-heikeqs/kaeuzchen/kaeuzchenlager"
        ]
      },
      "configurations": {
        "qs": {
          "commands": [
            "rm -rf /home/heike/deployments/x300-heikeqs/kaeuzchen/kaeuzchenlager/quarkus-app",
            "mv backend/kaeuzchenlager/target/quarkus-app /home/heike/deployments/x300-heikeqs/kaeuzchen/kaeuzchenlager"
          ]
        },
        "prod": {
          "commands": [
            "rm -rf /home/heike/deployments/vserver1/kaeuzchen/kaeuzchenlager/quarkus-app",
            "mv backend/kaeuzchenlager/target/quarkus-app /home/heike/deployments/vserver1/kaeuzchen/kaeuzchenlager"
          ]
        }
      }
    }
  }
}
