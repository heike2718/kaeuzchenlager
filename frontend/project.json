{
  "name": "frontend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": "frontend",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx serve kaeuzchen-workspace"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx run kaeuzchen-workspace:build:development"
      },
      "configurations": {
        "qs": {
          "command": "nx run kaeuzchen-workspace:build:qs"
        },
        "prod": {
          "command": "nx run kaeuzchen-workspace:build:production"
        }
      },
      "outputs": [
        "{workspaceRoot}/frontend/kaeuzchen-workspace/dist/kaeuzchen-workspace"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx run kaeuzchen-workspace:test"
      }
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx run kaeuzchen-workspace:test-coverage"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx run kaeuzchen-workspace:lint"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx run kaeuzchen-workspace:format"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx run kaeuzchen-workspace:format-check"
      }
    },
    "cleanup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx run kaeuzchen-workspace:cleanup"
      }
    },
    "graph": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx run kaeuzchen-workspace:graph"
      }
    }
  }
}
