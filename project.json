{
  "name": "kaeuzchenlager",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": ".",
  "targets": {
    "fe-serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run frontend:serve"
      }
    },
    "fe-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run frontend:build"
      },
      "configurations": {
        "qs": {
          "command": "nx run frontend:build --configuration=qs"
        },
        "prod": {
          "command": "nx run frontend:build --configuration=prod"
        }
      }
    },
    "fe-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run frontend:test"
      }
    },
    "fe-lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run frontend:lint"
      }
    },
    "fe-graph": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "frontend/kaeuzchen-workspace",
        "command": "nx graph"
      }
    },
    "be-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run kaeuzchenlager-api:dev"
      }
    },
    "be-debug": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run kaeuzchenlager-api:debug"
      }
    },
    "be-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run kaeuzchenlager-api:test"
      }
    },
    "be-package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run kaeuzchenlager-api:package"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run orchestrator:package"
      },
      "configurations": {
        "qs": {
          "command": "nx run orchestrator:package --configuration=qs"
        },
        "prod": {
          "command": "nx run orchestrator:package --configuration=prod"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run orchestrator:deploy"
      },
      "configurations": {
        "qs": {
          "command": "nx run orchestrator:deploy --configuration=qs"
        },
        "prod": {
          "command": "nx run orchestrator:deploy --configuration=prod"
        }
      }
    }
  }
}
